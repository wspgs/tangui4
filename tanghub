end,
}
end
local function applyTheme(window, name)
local theme = THEMES[name]
if not theme then
return
end
local lookup = {}
for key, color in pairs(THEME) do
lookup[color:ToHex()] = key
end
for _, object in ipairs(window.gui:GetDescendants()) do
for _, property in ipairs(THEME_PROPERTIES) do
local success, current = pcall(function()
return object[property]
end)
if success and typeof(current) == "Color3" then
local key = lookup[current:ToHex()]
if key then
tween(object, 0.35, { [property] = theme[key] }, Enum.EasingStyle.Quad)
end
end
end
end
for key, color in pairs(theme) do
THEME[key] = color
end
end
function Window:setTransparency(value)
value = math.clamp(value or 0, 0, 0.9)
GLASS = value
self.transparency = value
local panels = {}
for _, key in ipairs({ "background", "sidebar", "header", "element" }) do
panels[THEME[key]:ToHex()] = value
end
panels[THEME.field:ToHex()] = value * 0.5
local function apply(object)
if object.BackgroundTransparency >= 1 then
return
end
local target = panels[object.BackgroundColor3:ToHex()]
if target then
object.BackgroundTransparency = target
end
end
apply(self.main)
for _, object in ipairs(self.main:GetDescendants()) do
if object:IsA("GuiObject") then
apply(object)
end
end
end
function Window:setTheme(name)
applyTheme(self, name)
self.themeName = name
self:updateIslandColors()
self:updateNavigation()
end
