local function toPixels(position)
local camera = workspace.CurrentCamera
local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
return Vector2.new(
position.X.Scale * viewport.X + position.X.Offset,
position.Y.Scale * viewport.Y + position.Y.Offset
)
end
local function resolveLogo(source)
if type(source) ~= "string" or source == "" then
return nil
end
if source == "embedded" then
local success, content = pcall(function()
local decode = (crypt and crypt.base64decode) or base64decode
local path = "TangHub/logo_v1.png"
if not isfolder("TangHub") then
makefolder("TangHub")
end
if not isfile(path) then
writefile(path, decode(LOGO_BASE64))
end
return getcustomasset(path)
end)
if success then
return content
end
return nil
end
if string.find(source, "^rbxassetid://") or string.find(source, "^rbxasset://") then
return source
end
if string.find(source, "^%d+$") then
return "rbxassetid://" .. source
end
local path = source
if string.find(source, "^https?://") then
path = "TangHub/logo.png"
pcall(function()
if not isfolder("TangHub") then
makefolder("TangHub")
end
local response = request({ Url = source, Method = "GET" })
if response and response.StatusCode == 200 and #response.Body > 0 then
writefile(path, response.Body)
end
end)
end
local success, content = pcall(function()
if isfile(path) then
return getcustomasset(path)
end
end)
if success then
return content
end
return nil
end
