function Window:paintGenie(size)
local count = #self.genieStrips
local sidebarFraction = self.sidebarOpen and SIDEBAR_WIDTH / size.X.Offset or 0
local headerFraction = HEADER_HEIGHT / size.Y.Offset
for index, strip in ipairs(self.genieStrips) do
local t = (index - 0.5) / count
local rightColor = t < headerFraction and THEME.header or THEME.background
if sidebarFraction > 0.001 then
strip.gradient.Color = ColorSequence.new({
ColorSequenceKeypoint.new(0, THEME.sidebar),
ColorSequenceKeypoint.new(sidebarFraction, THEME.sidebar),
ColorSequenceKeypoint.new(math.min(sidebarFraction + 0.001, 0.999), rightColor),
ColorSequenceKeypoint.new(1, rightColor),
})
else
strip.gradient.Color = ColorSequence.new(rightColor)
end
end
end
function Window:updateGenie(progress, opacity, geometry)
local strips = self.genieStrips
local count = #strips
local ys, xs, ws = {}, {}, {}
for index = 1, count do
local t = (index - 0.5) / count
local reach = math.clamp(progress * (1 + GENIE_LAG) - t * GENIE_LAG, 0, 1)
local smooth = reach * reach * (3 - 2 * reach)
local baseY = geometry.top + t * geometry.height
ys[index] = baseY + (geometry.target.Y - baseY) * smooth
xs[index] = geometry.center.X + (geometry.target.X - geometry.center.X) * smooth
ws[index] = geometry.width + (geometry.islandWidth - geometry.width) * smooth
end
for index = 1, count do
local nextIndex = math.min(index + 1, count)
local previousIndex = math.max(index - 1, 1)
local span = math.abs(ys[nextIndex] - ys[previousIndex]) / math.max(nextIndex - previousIndex, 1)
local frame = strips[index].frame
frame.Position = UDim2.fromOffset(xs[index], ys[index])
frame.Size = UDim2.fromOffset(ws[index], math.max(span + 2, 2))
frame.BackgroundTransparency = 1 - opacity * (1 - GLASS)
end
end
function Window:playGenie(closing, token)
self:buildGenie()
local size = self.maximized and WINDOW_SIZE_LARGE or WINDOW_SIZE
local fit = self:getFitScale()
local center = toPixels(self.restPosition)
local geometry = {
center = center,
width = size.X.Offset * fit,
height = size.Y.Offset * fit,
top = center.Y - size.Y.Offset * fit / 2,
target = toPixels(self.island.Position),
islandWidth = ISLAND_WIDTH,
}
self:paintGenie(size)
if self.genieConnection then
self.genieConnection:Disconnect()
self.genieConnection = nil
end
self.genieHolder.Visible = true
local startClock = os.clock()
self.genieConnection = runService.RenderStepped:Connect(function()
if self.visibleToken ~= token then
self.genieConnection:Disconnect()
self.genieConnection = nil
self.genieHolder.Visible = false
return
end
local alpha = math.clamp((os.clock() - startClock) / GENIE_DURATION, 0, 1)
local eased = alpha < 0.5 and 4 * alpha ^ 3 or 1 - (-2 * alpha + 2) ^ 3 / 2
local progress = closing and eased or 1 - eased
local opacity
if closing then
opacity = math.clamp(alpha / 0.12, 0, 1)
self.main.GroupTransparency = math.clamp(alpha / 0.2, 0, 1)
else
opacity = math.clamp((1 - alpha) / 0.15, 0, 1)
self.main.GroupTransparency = 1 - math.clamp((alpha - 0.8) / 0.2, 0, 1)
end
self:updateGenie(progress, opacity, geometry)
if alpha >= 1 then
self.genieConnection:Disconnect()
self.genieConnection = nil
self.genieHolder.Visible = false
if closing then
self.main.Visible = false
self:setIslandVisible(true)
else
self.main.GroupTransparency = 0
end
end
end)
end
